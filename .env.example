# Wzorzec konfiguracji lokalnej. Skopiuj do .env i uzupełnij własnymi wartościami.
# .env jest ignorowany przez git — nie dopisuj do niego sekretów przeznaczonych
# dla serwera (te trzymamy w Supabase secrets / GitHub Secrets).

# Database
DATABASE_URL=

# SMTP Configuration for Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# File Storage
FILE_STORAGE_DIR=./storage

# Supabase (ustawiane automatycznie w Lovable).
# Klucz publikowalny/anon nie jest sekretem — trafia i tak do bundla przeglądarki —
# ale wzorzec zostawiamy pusty, żeby nikt nie kopiował wartości z repozytorium.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
