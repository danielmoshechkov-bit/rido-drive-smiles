# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/rido_db

# SMTP Configuration for Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="RIDO <no-reply@twojadomena.pl>"

# File Storage
FILE_STORAGE_DIR=./storage

# Supabase Configuration (automatically set in Lovable)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Publiczna allowlista dokładnych originów stron płatności. Pozostaw puste,
# dopóki adapter operatora i jego domeny nie zostaną zweryfikowane.
VITE_PAYMENT_REDIRECT_ORIGINS=

# Edge Function security (set as server-side secrets; never prefix with VITE_)
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
APP_PUBLIC_URL=https://app.example.com
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
AI_SECRETS_ENC_KEY=replace-with-at-least-32-random-characters
EMAIL_CREDENTIALS_ENC_KEY=replace-with-at-least-32-random-characters
# Oddzielny, losowy klucz HMAC server-only do krótkotrwałych capability AI.
# Nie używaj dawnych VOICE_INTERNAL_SECRET ani VOICE_LLM_TOKEN — zostały wycofane.
AI_CAPABILITY_SIGNING_SECRET=replace-with-at-least-32-random-characters
AI_VOICE_LIVE_EXECUTION_ENABLED=false
ELEVENLABS_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
DEBT_UPDATE_INTERNAL_SECRET=replace-with-at-least-32-random-characters
REMINDERS_CRON_INTERNAL_SECRET=replace-with-at-least-32-random-characters
RENTAL_DISPATCHER_INTERNAL_SECRET=replace-with-at-least-32-random-characters
KSEF_CREDENTIALS_ENC_KEY=replace-with-at-least-32-random-characters
PAYMENT_INTENT_CREATION_ENABLED=false
# Nazwy poniżej są przykładowymi sekretami server-only. Rekord
# payment_gateway_config przechowuje wyłącznie ich nazwy, nigdy wartości.
P24_API_KEY=replace-with-provider-api-key
P24_CRC_SECRET=replace-with-provider-crc-secret

# Keep high-risk integrations disabled until their Phase B/F gates pass.
REMINDERS_DELIVERY_ENABLED=false
KSEF_EXTERNAL_OPERATIONS_ENABLED=false
KSEF_PRODUCTION_ENABLED=false

# Local Supabase only; production must not set ENVIRONMENT=local
ENVIRONMENT=local
LOCAL_TEST_SETUP_SECRET=replace-with-at-least-32-random-characters
